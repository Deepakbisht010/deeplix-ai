# ============================================
# Deeplix AI - Root Environment Variables
# Copy this to backend/.env and fill in values
# ============================================

# === BACKEND ===
NODE_ENV=development
PORT=5000

# MongoDB Connection
# Local: mongodb://localhost:27017/nexus-ai
# Atlas: mongodb+srv://user:************.com/nexus-ai
MONGODB_URI=mongodb://localhost:27017/nexus-ai

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# Gemini API Key 
GEMINI_API_KEY=Your_api_key

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# === FRONTEND ===
REACT_APP_API_URL=http://localhost:5000/api
